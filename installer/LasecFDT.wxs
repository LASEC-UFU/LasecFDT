<?xml version="1.0" encoding="UTF-8"?>
<!--
  Instalador do LasecFDT (WiX 3.14). Gerado por tools/release/build-release.ps1, que antes:
   - compila o motor (net48 x86) e a UI Flutter (x64);
   - monta $(var.StageDir) = UI + runtime VC++ ao lado + engine\ (Host, worker, CLI);
   - gera AppFiles.wxs com heat.
  Componentes FDT: só merge modules oficiais REDISTRIBUÍVEIS da FDT 1.2.1 (pasta "Redistributable" do pacote FDT-JIG;
  especificação §7.1.4):
   - FDT_100 (FDT100.dll + type library; compartilhado, com contagem de referência);
   - FDT_XMLSchemata (schemas do Frame em engine\FDT XML Schemas\).
  Os schemas HART da FDT 1.2 não são redistribuíveis: o motor usa os que outros Frames já instalaram na máquina
  (LasecFDT.Fdt1.Frame.FdtSchemaLocator).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product Id="*"
           Name="LasecFDT"
           Language="1046"
           Codepage="1252"
           Version="$(var.Version)"
           Manufacturer="LASEC - UFU"
           UpgradeCode="{92E0426D-EA6A-40C3-B15D-ABA024066E11}">

    <!-- Pacote de 32 bits: o motor, os workers e os DTMs FDT 1.x são x86 (a UI x64 roda normalmente daqui). -->
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x86"
             Description="LasecFDT - Frame FDT" Comments="Frame FDT 1.2 com interface moderna para estações e thin clients" />

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais nova do LasecFDT já está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="LasecFDT.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="LasecFDT.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/josuemoraisgh/LasecFDT" />

    <!-- .NET Framework 4.8 (motor e workers): Release >= 528040 -->
    <Property Id="NETFX48RELEASE">
      <RegistrySearch Id="NetFx48Release" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" />
    </Property>
    <Condition Message="O LasecFDT exige o .NET Framework 4.8 ou mais novo."><![CDATA[Installed OR (NETFX48RELEASE >= "#528040")]]></Condition>

    <!-- Nome localizado do grupo Usuários (ex.: "Usuários" no Windows em português) -->
    <PropertyRef Id="WIX_ACCOUNT_USERS" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="LasecFDT">
          <Directory Id="ENGINEDIR" Name="engine">
            <!-- engine\FDT XML Schemas\: schemas FDT 1.2.1 do Frame (§7.1.4). O módulo PROFIBUS não entra: instala arquivos
                 de mesmo nome na mesma pasta (conflito ICE30) e não é necessário para HART. -->
            <Merge Id="FdtXmlSchemata" SourceFile="$(var.RedistDir)\FDT_XMLSchemata.msm" DiskId="1" Language="0" />
          </Directory>
        </Directory>
      </Directory>
      <!-- FDT100.dll + type library (o módulo define o próprio destino na pasta de sistema de 32 bits) -->
      <Merge Id="Fdt100" SourceFile="$(var.RedistDir)\FDT_100.msm" DiskId="1" Language="0" />

      <Directory Id="CommonAppDataFolder">
        <Directory Id="PLANTDIR" Name="LasecFDT" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="MENUDIR" Name="LasecFDT" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <!--
      Pasta comum da planta (projetos, catálogo, arrendamentos, auditoria), compartilhada pelas estações do servidor:
      o grupo Usuários precisa escrever nela. Permanente: desinstalar não apaga projetos.
    -->
    <DirectoryRef Id="PLANTDIR">
      <Component Id="PlantFolder" Guid="{9DDF6800-2EAD-4E64-B952-382538D0F863}" Permanent="yes">
        <CreateFolder>
          <util:PermissionEx User="[WIX_ACCOUNT_USERS]" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="MENUDIR">
      <Component Id="Shortcuts" Guid="{6E2C2BDD-DBCA-4F27-B112-053E4210AAD7}">
        <Shortcut Id="MenuShortcut" Name="LasecFDT" Description="Frame FDT" Target="[INSTALLFOLDER]lasecfdt_ui.exe" WorkingDirectory="INSTALLFOLDER" Icon="LasecFDT.ico" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="LasecFDT" Description="Frame FDT" Target="[INSTALLFOLDER]lasecfdt_ui.exe" WorkingDirectory="INSTALLFOLDER" Icon="LasecFDT.ico" />
        <RemoveFolder Id="RemoveMenuDir" On="uninstall" />
        <!-- Atalhos não anunciados exigem chave em HKCU como KeyPath (ICE38/ICE43), padrão do WiX. -->
        <RegistryValue Root="HKCU" Key="Software\LASEC\LasecFDT" Name="Shortcuts" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="LasecFDT" Level="1" Absent="disallow">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="PlantFolder" />
      <ComponentRef Id="Shortcuts" />
      <MergeRef Id="Fdt100" />
      <MergeRef Id="FdtXmlSchemata" />
    </Feature>

    <!-- Ações de autorregistro trazidas pelo merge module de schemas, na posição padrão do Windows Installer. -->
    <InstallExecuteSequence>
      <SelfUnregModules Sequence="2200" />
      <SelfRegModules Sequence="6500" />
    </InstallExecuteSequence>
    <!-- ResolveSource vindo do merge module: na fase de custeio, como exige o ICE27. -->
    <InstallUISequence>
      <ResolveSource After="CostInitialize" />
    </InstallUISequence>

    <!-- Assistente: boas-vindas → pasta de instalação → instalar (sem página de licença). -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">1</Publish>
    </UI>
  </Product>
</Wix>
